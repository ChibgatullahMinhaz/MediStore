datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------
// ENUMS
// -----------------------------------------------

enum UserRole {
  ADMIN
  SELLER
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum OrderStatus {
  PLACED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

// -----------------------------------------------
// MODELS
// -----------------------------------------------

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  password  String
  role      UserRole   @default(CUSTOMER)
  status    UserStatus @default(ACTIVE)
  phone     String?
  address   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  medicines Medicine[] // A seller can list multiple medicines
  orders    Order[]    // A customer can place multiple orders
  reviews   Review[]   // A customer can leave reviews

  @@map("users")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  medicines Medicine[]

  @@map("categories")
}

model Medicine {
  id           String   @id @default(cuid())
  name         String
  manufacturer String
  price        Float
  stock        Int      @default(0)
  description  String
  imageUrl     String?
  isOTC        Boolean  @default(true) // Over-the-counter status

  // Foreign Keys
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orderItems OrderItem[]
  reviews    Review[]

  @@map("medicines")
}

model Order {
  id              String        @id @default(cuid())
  totalAmount     Float
  status          OrderStatus   @default(PLACED)
  paymentStatus   PaymentStatus @default(PENDING)
  shippingAddress String
  contactPhone    String

  // Foreign Keys
  customerId String
  customer   User   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orderItems OrderItem[]

  @@map("orders")
}

model OrderItem {
  id       String @id @default(cuid())
  quantity Int
  price    Float  // Product price at the time of order

  // Foreign Keys
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model Review {
  id      String @id @default(cuid())
  rating  Int    // 1 to 5
  comment String

  // Foreign Keys
  customerId String
  customer   User   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reviews")
}